{
  "name": "frontend",
  "version": "0.2.2",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "NODE_OPTIONS=--experimental-global-webcrypto vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:cypress": "cypress open --project tests",
    "lint": "tsc --noEmit",
    "debug": "node --inspect ./node_modules/vite/bin/vite.js --host 0.0.0.0"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "billboard.js": "^2.2.0-next.7",
    "core-js": "^3.4.3",
    "d3": "^5.16.0",
    "d3-scale": "^3.3.0",
    "d3-scale-chromatic": "^1.5.0",
    "d3-selection": "^1.4.2",
    "file-saver": "^2.0.2",
    "json-schema": "^0.4.0",
    "loader-utils": "^3.2.1",
    "lodash": "^4.17.21",
    "minimist": "^1.2.7",
    "moment": "^2.27.0",
    "papaparse": "^5.3.0",
    "register-service-worker": "^1.0.0",
    "sass": "^1.26.8",
    "sass-loader": "^8.0.2",
    "typesafe-vuex": "^3.1.1",
    "url-parse": "^1.5.10",
    "vee-validate": "^2.1.7",
    "vue": "^2.7.16",
    "vue-class-component": "^7.2.3",
    "vue-head": "^2.2.0",
    "vue-multiselect": "^2.1.6",
    "vue-property-decorator": "^9.0.0",
    "vue-router": "^3.3.1",
    "vue2-datepicker": "^3.6.0",
    "vuedraggable": "^2.24.0",
    "vuetify": "^2.3.3",
    "vuex": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@vitejs/plugin-vue2": "^2.3.3",
    "@vue/test-utils": "^1.3.6",
    "autoprefixer": "^10.5.0",
    "cypress": "^5.2.0",
    "jsdom": "^25.0.1",
    "terser": "^5.36.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "1.1.0",
    "vitest": "^2.1.8",
    "vue-template-compiler": "^2.7.16"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ]
}
